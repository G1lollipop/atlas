# Copy to .env and fill in real values for local docker-compose runs.
# .env is gitignored - never commit real secrets.

# Used to sign/verify JWTs issued by the api service. docker-compose falls back
# to "dev-secret-change-me" if this is unset, which is fine for local dev only.
JWT_SECRET=dev-secret-change-me

# Overrides the default docker-compose DATABASE_URL if you point services at a
# different Postgres instance.
DATABASE_URL=postgres://atlas:atlas@postgres:5432/atlas?sslmode=disable

# Worker capabilities advertised to the scheduler. CPU is in millicores;
# memory and GPU memory are in MB. GPU type and memory must be supplied when
# WORKER_GPU_COUNT is greater than zero. WORKER_LABELS is a JSON string map.
WORKER_CPU_CAPACITY_MILLIS=4000
WORKER_MEMORY_CAPACITY_MB=8192
WORKER_GPU_COUNT=0
WORKER_GPU_TYPE=
WORKER_GPU_MEMORY_MB=0
WORKER_LABELS={}
