{
  "id": null,
  "uid": "atlas-overview",
  "title": "Atlas Overview",
  "tags": ["atlas"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pending queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "atlas_queue_depth",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs submitted",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "atlas_jobs_submitted_total",
          "legendFormat": "submitted"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Run completions per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(atlas_runs_completed_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scheduler leader",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(atlas_scheduler_is_leader)",
          "legendFormat": "leader"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "No leader" },
                "1": { "text": "Leader active" }
              }
            }
          ]
        },
        "overrides": []
      }
    }
  ]
}
