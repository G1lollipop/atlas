{
  "id": null,
  "uid": "atlas-failures",
  "title": "Failures",
  "tags": ["atlas", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Failed attempts and successful runs",
      "description": "Failed attempts include attempts that will be retried; successful runs count final successful completions.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(atlas_jobs_failed_total[5m]))", "legendFormat": "failed attempts / sec" },
        { "refId": "B", "expr": "sum(rate(atlas_jobs_completed_total[5m]))", "legendFormat": "successful runs / sec" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Retries scheduled",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(atlas_retry_total[5m]))", "legendFormat": "retries / sec" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dead-letter events",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(atlas_dead_letter_total[5m]))", "legendFormat": "dead letters / sec" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Expired worker leases reclaimed",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(atlas_lease_expired_total[5m]))", "legendFormat": "leases / sec" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job execution duration p95",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(atlas_job_execution_seconds_bucket[5m])))", "legendFormat": "p95" }
      ]
    }
  ]
}
